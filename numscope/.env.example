# Copy to .env (never commit .env). Every value is optional.

# Numverify free tier: https://numverify.com  (leave empty to disable)
NUMVERIFY_API_KEY=

# Free Numverify plans may not support HTTPS. Setting this to true sends the
# API key over plain HTTP. Leave false unless you accept that risk.
NUMVERIFY_ALLOW_HTTP=false

# Network timeout in seconds for provider calls.
HTTP_TIMEOUT=10

# ---- Web deployment (all optional) -----------------------------------------
# Requests per IP per window / across all users per window.
WEB_RATE_LIMIT=10
WEB_RATE_WINDOW=60
WEB_GLOBAL_LIMIT=120
# Let the public site call Numverify? Off by default: it burns your quota and
# sends visitors' numbers to a third party.
WEB_ENABLE_PROVIDERS=false
WEB_DAILY_PROVIDER_CAP=50
# Reverse-proxy hops in front of the app (Render/Railway/Fly = 1, local = 0).
TRUST_PROXY_HOPS=0
