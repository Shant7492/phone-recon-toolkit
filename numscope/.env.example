# Copy to .env (never commit .env). Every value is optional.

# Numverify free tier: https://numverify.com  (leave empty to disable)
NUMVERIFY_API_KEY=

# Free Numverify plans may not support HTTPS. Setting this to true sends the
# API key over plain HTTP. Leave false unless you accept that risk.
NUMVERIFY_ALLOW_HTTP=false

# Network timeout in seconds for provider calls.
HTTP_TIMEOUT=10
